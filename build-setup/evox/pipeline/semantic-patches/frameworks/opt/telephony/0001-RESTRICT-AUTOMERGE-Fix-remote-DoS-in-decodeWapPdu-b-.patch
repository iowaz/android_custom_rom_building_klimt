+    @Test
+    @MediumTest
+    public void testBroadcastSms_nullTracker_failsGracefully() {
+        transitionFromStartupToIdle();
+
+        mGsmInboundSmsHandler.sendMessage(InboundSmsHandler.EVENT_BROADCAST_SMS, null);
