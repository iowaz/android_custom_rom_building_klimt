 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/configs/props/vendor.prop b/configs/props/vendor.prop
index fc3f6e1..eedf4a4 100644
--- a/configs/props/vendor.prop
+++ b/configs/props/vendor.prop
@@ -194,7 +194,7 @@ debug.hwui.initialize_gl_always=1
 debug.mediatek.appgamepq_compress=1
 debug.mediatek.disp_decompress=1
 debug.mtk_tflite.target_nnapi=29
-debug.renderengine.backend=skiagl
